<odoo noupdate="1">
    <record id="ir_cron_autovacuum_ai_connection_execution_iteration" model="ir.cron">
        <field name="name">AI Connection: Autovacuum Iterations</field>
        <field name="model_id" ref="model_ai_connection_execution_iteration" />
        <field name="state">code</field>
        <field name="code">model._autovacuum()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="cron_ai_step_processor" model="ir.cron">
        <field name="name">AI Connection: Process Step</field>
        <field name="model_id" ref="model_ai_connection_execution" />
        <field name="state">code</field>
        <field name="code">model._cron_process_single_step()</field>
        <field name="active" eval="True" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
