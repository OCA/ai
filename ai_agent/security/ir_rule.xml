<odoo>
    <record id="ai_agent_session_own_rule" model="ir.rule">
        <field
            name="name"
        >AI Agent Session: own sessions, or sessions of an agent you are</field>
        <field name="model_id" ref="model_ai_agent_session" />
        <field
            name="domain_force"
        >['|', ('user_id', '=', user.id), ('agent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="ai_agent_session_admin_rule" model="ir.rule">
        <field name="name">AI Agent Session: administrators see all</field>
        <field name="model_id" ref="model_ai_agent_session" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>
</odoo>
