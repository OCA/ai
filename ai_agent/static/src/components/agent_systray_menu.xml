<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ai_agent.AgentSystrayMenu">
        <Dropdown
            t-if="agents.agents.length"
            state="dropdown"
            position="'bottom-end'"
            menuClass="'o-ai_agent-AgentSystrayMenu-dropdown p-0 py-1'"
        >
            <button
                class="o-ai_agent-AgentSystrayMenu-toggler"
                title="AI agents"
                aria-label="AI agents"
            >
                <svg
                    class="o-ai_agent-AgentSystrayMenu-icon"
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <rect x="4" y="8" width="16" height="12" rx="3" />
                    <path d="M12 8V4" />
                    <circle cx="12" cy="3" r="1" />
                    <circle cx="9" cy="14" r="1.2" fill="currentColor" />
                    <circle cx="15" cy="14" r="1.2" fill="currentColor" />
                    <path d="M2 13v3M22 13v3" />
                </svg>
            </button>
            <t t-set-slot="content">
                <div class="o-ai_agent-AgentSystrayMenu">
                    <AgentSidebar
                        compact="true"
                        getContext.bind="getContext"
                        onAction="() => this.dropdown.close()"
                    />
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
