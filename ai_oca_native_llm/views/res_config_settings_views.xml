<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.llm</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="Native AI"
                    string="Native AI"
                    name="ai_oca_native_llm"
                >
                    <block
                        title="LLM API Configuration"
                        name="ai_llm_setting_container"
                    >
                        <setting
                            id="ai_llm_base_url_setting"
                            string="Base URL"
                            help="URL to the LLM API endpoint"
                        >
                            <field name="ai_llm_base_url" class="w-100" />
                        </setting>
                        <setting
                            id="ai_llm_api_key_setting"
                            string="API Key"
                            help="Access Key for the LLM Provider"
                        >
                            <field
                                name="ai_llm_api_key"
                                class="w-100"
                                password="True"
                            />
                        </setting>
                        <setting
                            id="ai_llm_reasoning_model_setting"
                            string="Reasoning Model"
                            help="Model for complex reasoning (e.g., llama3, gpt-4o)"
                        >
                            <field name="ai_llm_reasoning_model" class="w-100" />
                        </setting>
                        <setting
                            id="ai_llm_fast_model_setting"
                            string="Fast Model"
                            help="Model for rapid intent extraction (e.g., llama3.2, gpt-4o-mini)"
                        >
                            <field name="ai_llm_fast_model" class="w-100" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_ai_llm_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field
            name="context"
        >{'module' : 'ai_oca_native_llm', 'bin_size': False}</field>
    </record>

    <menuitem
        id="menu_ai_llm_settings"
        name="LLM Settings"
        parent="ai_oca_native_base.menu_ai_oca_native_root"
        action="action_ai_llm_config_settings"
        groups="ai_oca_native_base.group_ai_admin"
        sequence="100"
    />
</odoo>
