<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="general_settings" position="inside">
                <block title="AI" name="ai_tool_confirm_setting_container">
                    <setting
                        id="ai_tool_confirm_expiration_setting"
                        string="AI confirmation expiration"
                        help="Hours a pending AI action waits for confirmation (0: never expires)"
                    >
                        <field name="ai_tool_confirm_expiration_hours" />
                    </setting>
                    <setting
                        id="ai_tool_confirm_limit_setting"
                        string="AI confirmation limit"
                        help="Pending AI actions a user can receive in an hour (0: no limit)"
                    >
                        <field name="ai_tool_confirm_max_pending_per_hour" />
                    </setting>
                    <setting
                        id="ai_tool_confirm_fallback_approver_setting"
                        string="AI confirmation fallback approver"
                        help="Confirms AI actions with no person behind (scheduled actions, job queues, webhooks) on records without a responsible user"
                    >
                        <field name="ai_tool_confirm_fallback_approver_id" />
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
