<odoo>
    <record id="ai_message_import_change_view_list" model="ir.ui.view">
        <field name="name">ai.message.import.change.list</field>
        <field name="model">ai.message.import.change</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date" />
                <field name="operation" />
                <field name="field_label" />
                <field name="old_value" />
                <field name="new_value" />
                <field name="document_id" />
                <field name="processing_ref" optional="hide" />
                <field name="reason" optional="hide" />
                <field name="message_ids" widget="many2many_tags" optional="hide" />
                <field name="sender_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="ai_message_import_change_view_search" model="ir.ui.view">
        <field name="name">ai.message.import.change.search</field>
        <field name="model">ai.message.import.change</field>
        <field name="arch" type="xml">
            <search>
                <field name="document_id" />
                <field name="sender_id" />
                <field name="field_label" />
                <filter
                    name="updates"
                    string="Updates"
                    domain="[('operation', '!=', 'create')]"
                />
                <group expand="0" string="Group By" name="group_by">
                    <filter
                        name="group_quote"
                        string="Document"
                        context="{'group_by': 'document_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_message_import_change" model="ir.actions.act_window">
        <field name="name">Change history</field>
        <field name="res_model">ai.message.import.change</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No change yet</p>
            <p>Every value written by the module on an order is recorded here.</p>
        </field>
    </record>
</odoo>
