<odoo>
    <record id="ai_message_import_product_mapping_view_list" model="ir.ui.view">
        <field name="name">ai.message.import.product.mapping.list</field>
        <field name="model">ai.message.import.product.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sender_id" options="{'no_create': True}" />
                <field name="company_id" column_invisible="1" />
                <field
                    name="partner_id"
                    domain="[('parent_id', '=', False)]"
                    options="{'no_create': True}"
                />
                <field name="key_type" />
                <field name="partner_text" placeholder="e.g. FN-100 or Tornillo M6" />
                <field name="product_id" options="{'no_create': True}" />
                <field name="source" optional="show" />
                <field name="usage_count" optional="show" />
                <field name="last_used" optional="hide" />
            </list>
        </field>
    </record>

    <record id="ai_message_import_product_mapping_view_search" model="ir.ui.view">
        <field name="name">ai.message.import.product.mapping.search</field>
        <field name="model">ai.message.import.product.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_text" />
                <field name="product_id" />
                <field name="sender_id" />
                <field name="partner_id" />
                <group expand="0" string="Group By">
                    <filter
                        name="group_sender"
                        string="Sender"
                        context="{'group_by': 'sender_id'}"
                    />
                    <filter
                        name="group_partner"
                        string="Vendor / Customer"
                        context="{'group_by': 'partner_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_message_import_product_mapping" model="ir.actions.act_window">
        <field name="name">Learned equivalences</field>
        <field name="res_model">ai.message.import.product.mapping</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Teach a product to the AI</p>
            <p>
                When a product of a document is corrected, the equivalence is kept
                for the next documents of the same sender and partner. You can also
                add one: how the vendor or the customer writes the product (its
                reference or its description) and the product of Odoo it is.
            </p>
        </field>
    </record>
</odoo>
