<odoo>
    <record id="ai_message_import_uom_mapping_view_list" model="ir.ui.view">
        <field name="name">ai.message.import.uom.mapping.list</field>
        <field name="model">ai.message.import.uom.mapping</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sender_id" options="{'no_create': True}" />
                <field name="company_id" column_invisible="1" />
                <field name="uom_text" placeholder="e.g. saco" />
                <field name="uom_id" options="{'no_create': True}" />
                <field name="usage_count" optional="show" />
                <field name="last_used" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="ai_message_import_uom_mapping_view_search" model="ir.ui.view">
        <field name="name">ai.message.import.uom.mapping.search</field>
        <field name="model">ai.message.import.uom.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="uom_text" />
                <field name="uom_id" />
                <field name="sender_id" />
            </search>
        </field>
    </record>

    <record id="action_ai_message_import_uom_mapping" model="ir.actions.act_window">
        <field name="name">Learned units</field>
        <field name="res_model">ai.message.import.uom.mapping</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Teach a unit to the AI</p>
            <p>
                When the unit of a line is chosen by hand, the unit it was written
                with is kept for the next documents of the sender. You can also add
                one: how the documents write it ("saco", "caja de kilo"...) and its
                unit of measure.
            </p>
        </field>
    </record>
</odoo>
