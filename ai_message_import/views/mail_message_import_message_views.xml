<odoo>
    <record id="mail_message_import_message_view_form" model="ir.ui.view">
        <field name="name">mail.message.import.message.form.ai</field>
        <field name="model">mail.message.import.message</field>
        <field
            name="inherit_id"
            ref="mail_message_import.mail_message_import_message_view_form"
        />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_documents"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                >
                    <field name="document_count" widget="statinfo" string="Documents" />
                </button>
            </div>
        </field>
    </record>
</odoo>
