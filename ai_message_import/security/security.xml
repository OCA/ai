<odoo>
    <record id="ai_message_import_document_rule" model="ir.rule">
        <field name="name">AI Message Import document: companies</field>
        <field name="model_id" ref="model_ai_message_import_document" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field
            name="groups"
            eval="[(4, ref('mail_message_import.group_mail_message_import_manager'))]"
        />
