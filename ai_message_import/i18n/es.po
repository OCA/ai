"%(line)s: quoted %(qty)s %(uom)s, conversion factor %(factor)s, ordered "
"%(final_qty)s %(final_uom)s."
msgstr ""
"%(line)s: presupuestado %(qty)s %(uom)s, factor de conversión %(factor)s, "
"pedido %(final_qty)s %(final_uom)s."

#. module: ai_message_import
#. odoo-python
#: code:addons/ai_message_import/services/order_builder.py:0
#, python-format
msgid ""
"%(line)s: quoted price %(quoted)s, Odoo price (%(origin)s) %(odoo)s; the "
"Odoo price is applied. Difference %(diff)s per %(uom)s, %(total)s for the "
"line."
msgstr ""
"%(line)s: precio del presupuesto %(quoted)s, precio de Odoo (%(origin)s) "
"%(odoo)s; se aplica el precio de Odoo. Diferencia de %(diff)s por %(uom)s, "
"%(total)s en la línea."

#. module: ai_message_import
#. odoo-python
#: code:addons/ai_message_import/services/order_builder.py:0
#, python-format
msgid ""
"%(line)s: tax of the document %(quoted)s%%, tax of Odoo %(taxes)s kept."
msgstr ""
"%(line)s: impuesto del documento %(quoted)s%%, se mantiene el impuesto de "
"Odoo %(taxes)s."

#. module: ai_message_import
#. odoo-python
#: code:addons/ai_message_import/services/order_builder.py:0
#, python-format
msgid ""
"%(line)s: the document states no unit, the unit %(uom)s of the order is "
"assumed."
msgstr ""
"%(line)s: el documento no indica unidad, se toma la unidad %(uom)s del "
"pedido."

#. module: ai_message_import
#. odoo-python
#: code:addons/ai_message_import/services/order_builder.py:0
#, python-format
msgid ""
"%(line)s: the price of Odoo is %(size)s times the quoted one and a box holds"
" %(size)s units, so the document counts its units: %(qty)s %(uom)s ordered "
"as %(final_qty)s %(final_uom)s."
msgstr ""
"%(line)s: el precio de Odoo es %(size)s veces el del documento y una caja "
"contiene %(size)s unidades, así que el documento cuenta sus unidades: "
"%(qty)s %(uom)s se piden como %(final_qty)s %(final_uom)s."

#. module: ai_message_import
#. odoo-python
#: code:addons/ai_message_import/services/order_builder.py:0
#, python-format
msgid ""
"%(line)s: the quoted discount %(quoted)s%% replaces the discount of "
"%(odoo)s%% of the price list."
msgstr ""
"%(line)s: el descuento del presupuesto, %(quoted)s%%, sustituye al descuento"
" de %(odoo)s%% de la tarifa."

#. module: ai_message_import
#. odoo-python
#: code:addons/ai_message_import/services/order_builder.py:0
#, python-format
msgid ""
"%(line)s: the quoted price is %(size)s times the one of Odoo and a box holds"
" %(size)s units, so the document counts boxes: %(qty)s %(uom)s ordered as "
"%(final_qty)s %(final_uom)s."
msgstr ""
"%(line)s: el precio del documento es %(size)s veces el de Odoo y una caja "
"contiene %(size)s unidades, así que el documento cuenta cajas: %(qty)s "
"%(uom)s se piden como %(final_qty)s %(final_uom)s."

#. module: ai_message_import
#. odoo-python
#: code:addons/ai_message_import/services/order_builder.py:0
#, python-format
msgid ""
