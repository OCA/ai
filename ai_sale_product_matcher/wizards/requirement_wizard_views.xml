<odoo>
    <record id="view_ai_sale_requirement_wizard_form" model="ir.ui.view">
        <field name="name">ai.sale.requirement.wizard.form</field>
        <field name="model">ai.sale.requirement.wizard</field>
        <field name="arch" type="xml">
            <form string="Find Products with AI">
                <group>
                    <field name="order_id" readonly="1" />
                    <field name="state" readonly="1" />
                    <field name="ai_connection_id" />
                </group>
                <group string="Filters (optional)">
                    <field
                        name="categ_id"
                        placeholder="All categories"
                        options="{'no_create': True}"
                    />
                </group>
                <group string="Requirements">
                    <field
                        name="attachment_ids"
                        widget="many2many_binary"
                        string="Requirement Files (PDF/Image)"
                    />
                    <field
                        name="requirement_text"
                        placeholder="Paste customer specification text, e.g. '120 bar operating pressure, 2.3 kW single-phase, detergent tank included'"
                    />
                </group>
                <group string="Extracted JSON (editable)">
                    <field
                        name="requirements_json"
                        widget="ace"
                        options="{'mode': 'javascript'}"
                        placeholder='{"pressure_bar": 120, "motor_power_kw": 2.3}'
                    />
                </group>
                <group string="Matches" invisible="not match_ids">
                    <field name="match_ids" readonly="1">
                        <list>
                            <field name="product_tmpl_id" />
                            <field name="match_count" />
                            <field name="total_required" />
                            <field name="match_percent" />
                            <field name="weighted_percent" />
                            <button
                                name="action_add_to_order"
                                string="Add to Order"
                                type="object"
                            />
                        </list>
                    </field>
                </group>
                <footer>
                    <button
                        name="action_extract"
                        string="Extract with AI"
                        type="object"
                        class="oe_highlight"
                    />
                    <button
                        name="action_match"
                        string="Find Matches"
                        type="object"
                        class="oe_highlight"
                    />
                    <button special="cancel" string="Close" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_ai_sale_requirement_wizard" model="ir.actions.act_window">
        <field name="name">Find Products with AI</field>
        <field name="res_model">ai.sale.requirement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
