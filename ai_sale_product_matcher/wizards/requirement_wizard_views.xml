<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_sale_requirement_wizard_form" model="ir.ui.view">
        <field name="name">ai.sale.requirement.wizard.form</field>
        <field name="model">ai.sale.requirement.wizard</field>
        <field name="arch" type="xml">
            <form string="Find Products with AI">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="ai_connection_id" required="1" options="{'no_create': True}"/>
                    <field name="state" readonly="1"/>
                </group>
                <group string="Requirements">
                    <field name="attachment_ids" widget="many2many_binary" string="Requirement Files (PDF/Image)"/>
                    <field name="requirement_text" placeholder="Paste requirement text, e.g. '120 bar soğuk sulu, 2.3kW monofaze, deterjan tanklı'"/>
                </group>
                <group string="Extracted JSON (editable)">
                    <field name="requirements_json" widget="ace" options="{'mode': 'javascript'}" placeholder='{"pressure_bar": 120, "phase": "Monofaze (M)"}'/>
                </group>
                <group string="Matches" invisible="not match_ids">
                    <field name="match_ids" readonly="1">
                        <list>
                            <field name="product_tmpl_id"/>
                            <field name="match_count"/>
                            <field name="total_required"/>
                            <field name="match_percent"/>
                            <field name="weighted_percent"/>
                            <button name="action_add_to_order" string="Add to Order" type="object"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_extract" string="Extract with AI" type="object" class="oe_highlight" invisible="state == 'extracting'"/>
                    <button name="action_refresh" string="Refresh" type="object" invisible="state != 'extracting'"/>
                    <button name="action_match" string="Find Matches" type="object" class="oe_highlight" invisible="state == 'extracting'"/>
                    <button special="cancel" string="Close"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_ai_sale_requirement_wizard" model="ir.actions.act_window">
        <field name="name">Find Products with AI</field>
        <field name="res_model">ai.sale.requirement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
