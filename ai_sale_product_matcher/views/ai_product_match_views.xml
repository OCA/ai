<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_ai_product_match_list" model="ir.ui.view">
        <field name="name">ai.product.match.list</field>
        <field name="model">ai.product.match</field>
        <field name="arch" type="xml">
            <list string="AI Product Matches">
                <field name="order_id" />
                <field name="product_tmpl_id" />
                <field name="match_count" />
                <field name="total_required" />
                <field name="match_percent" />
                <field name="weighted_percent" />
                <button
                    name="action_add_to_order"
                    string="Add to Order"
                    type="object"
                    class="oe_highlight"
                />
            </list>
        </field>
    </record>
    <record id="view_ai_product_match_form" model="ir.ui.view">
        <field name="name">ai.product.match.form</field>
        <field name="model">ai.product.match</field>
        <field name="arch" type="xml">
            <form string="AI Product Match">
                <sheet>
                    <group>
                        <field name="order_id" readonly="1" />
                        <field name="product_tmpl_id" readonly="1" />
                        <field name="product_id" readonly="1" />
                        <field name="match_count" readonly="1" />
                        <field name="total_required" readonly="1" />
                        <field name="match_percent" readonly="1" />
                        <field name="weighted_percent" readonly="1" />
                    </group>
                    <group string="Key breakdown">
                        <field
                            name="matched_keys"
                            widget="ace"
                            options="{'mode': 'javascript'}"
                            readonly="1"
                        />
                        <field
                            name="mismatched_keys"
                            widget="ace"
                            options="{'mode': 'javascript'}"
                            readonly="1"
                        />
                        <field
                            name="missing_keys"
                            widget="ace"
                            options="{'mode': 'javascript'}"
                            readonly="1"
                        />
                    </group>
                    <footer>
                        <button
                            name="action_add_to_order"
                            string="Add to Order"
                            type="object"
                            class="oe_highlight"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ai_product_match" model="ir.actions.act_window">
        <field name="name">AI Product Matches</field>
        <field name="res_model">ai.product.match</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_ai_product_match"
        name="AI Product Matches"
        parent="sale.sale_menu_root"
        sequence="30"
        action="action_ai_product_match"
        groups="sales_team.group_sale_manager"
    />
</odoo>
