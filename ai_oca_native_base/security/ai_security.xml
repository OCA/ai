<odoo>
    <record id="group_ai_user" model="res.groups">
        <field name="name">AI User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="implied_by_ids" eval="[(4, ref('base.group_user'))]" />
        <field
            name="comment"
        >Standard AI user capable of interacting with AI agents and threads.</field>
    </record>

    <record id="group_ai_admin" model="res.groups">
        <field name="name">AI Administrator</field>
        <field
            name="implied_ids"
            eval="[(4, ref('group_ai_user')), (4, ref('base.group_system'))]"
        />
        <field name="implied_by_ids" eval="[(4, ref('base.group_system'))]" />
        <field
            name="comment"
        >Administrator with full control over AI prompts, personas, agents, and settings.</field>
    </record>
</odoo>
