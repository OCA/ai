<odoo>
    <record id="view_task_form_openwebui_description" model="ir.ui.view">
        <field name="name">project.task.form.openwebui.description</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='description_page']//field[@name='description']"
                position="before"
            >
                <button
                    name="action_openwebui_draft_description"
                    type="object"
                    string="Draft with AI"
                    icon="fa-magic"
                    class="btn-secondary"
                    groups="project.group_project_user"
                />
            </xpath>
        </field>
    </record>
</odoo>
