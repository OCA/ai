<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_ai_extraction" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai.extraction</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="AI Document Extraction">
                    <setting
                        id="ai_document_extraction"
                        string="AI Document Extraction"
                        help="Extract invoice data from PDFs and images using a vision LLM (OpenRouter by default; local Ollama is also supported)."
                    >
                        <div class="content-group">
                            <div class="row mt16">
                                <label
                                    string="API Base URL"
                                    class="col-lg-4 o_light_label"
                                    for="ai_api_base_url"
                                />
                                <field name="ai_api_base_url" class="col-lg-8" />
                            </div>
                            <div class="row mt16">
                                <label
                                    string="API Key"
                                    class="col-lg-4 o_light_label"
                                    for="ai_api_key"
                                />
                                <field
                                    name="ai_api_key"
                                    class="col-lg-8"
                                    password="True"
                                />
                            </div>
                            <div class="row mt16">
                                <label
                                    string="Model Name"
                                    class="col-lg-4 o_light_label"
                                    for="ai_model_name"
                                />
                                <field name="ai_model_name" class="col-lg-8" />
                            </div>
                            <div class="row mt16">
                                <label
                                    string="Partner Match Threshold"
                                    class="col-lg-4 o_light_label"
                                    for="fuzzy_match_threshold"
                                />
                                <field name="fuzzy_match_threshold" class="col-lg-8" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
