<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_ai_extraction" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai.extraction</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='users_setting_container']" position="before">
                <block
                    title="AI Document Extraction"
                    name="ai_document_extraction_settings"
                    groups="base.group_no_one"
                >
                    <setting
                        id="ai_document_extraction"
                        string="AI Document Extraction"
                        help="Extract invoice data from PDFs and images using a vision LLM. Link an AI Connection (OpenRouter or local Ollama) configured in Settings > AI > AI Connection."
                    >
                        <div class="content-group">
                            <div class="row mt16">
                                <label
                                    string="AI Connection"
                                    class="col-lg-4 o_light_label"
                                    for="ai_connection_id"
                                />
                                <field name="ai_connection_id" class="col-lg-8" />
                            </div>
                            <div class="row mt16">
                                <label
                                    string="Partner Match Threshold"
                                    class="col-lg-4 o_light_label"
                                    for="fuzzy_match_threshold"
                                />
                                <field name="fuzzy_match_threshold" class="col-lg-8" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
