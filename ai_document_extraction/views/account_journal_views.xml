<odoo>
    <record id="view_account_journal_form_ai_extraction" model="ir.ui.view">
        <field name="name">account.journal.form.ai.extraction</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='advanced_settings']/group/group"
                position="inside"
            >
                <field
                    name="ai_connection_id"
                    invisible="type not in ('sale', 'purchase')"
                />
            </xpath>
        </field>
    </record>
</odoo>
