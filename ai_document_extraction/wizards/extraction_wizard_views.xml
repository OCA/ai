<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="extraction_wizard_view_form" model="ir.ui.view">
        <field name="name">extraction.wizard.form</field>
        <field name="model">extraction.wizard</field>
        <field name="arch" type="xml">
            <form string="Review AI Extraction">
                <group>
                    <group>
                        <field name="extracted_partner_name" />
                        <field name="partner_id" />
                    </group>
                    <group>
                        <field name="move_id" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_apply"
                        type="object"
                        string="Apply"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
