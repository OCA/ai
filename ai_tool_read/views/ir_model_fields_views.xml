<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_model_fields_view_form" model="ir.ui.view">
        <field name="model">ir.model.fields</field>
        <field name="inherit_id" ref="base.view_model_fields_form" />
        <field name="arch" type="xml">
            <field name="readonly" position="after">
                <field name="ai_no_read" />
            </field>
        </field>
    </record>

    <record id="ir_model_view_form" model="ir.ui.view">
        <field name="model">ir.model</field>
        <field name="inherit_id" ref="base.view_model_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='field_id']/form//field[@name='readonly']"
                position="after"
            >
                <field name="ai_no_read" />
            </xpath>
            <xpath
                expr="//field[@name='field_id']/list//field[@name='readonly']"
                position="after"
            >
                <field name="ai_no_read" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="ir_model_fields_view_tree" model="ir.ui.view">
        <field name="model">ir.model.fields</field>
        <field name="inherit_id" ref="base.view_model_fields_tree" />
        <field name="arch" type="xml">
            <field name="readonly" position="after">
                <field name="ai_no_read" optional="show" />
            </field>
        </field>
    </record>

    <record id="ir_model_fields_view_search" model="ir.ui.view">
        <field name="model">ir.model.fields</field>
        <field name="inherit_id" ref="base.view_model_fields_search" />
        <field name="arch" type="xml">
            <filter name="required" position="after">
                <separator />
                <filter
                    name="ai_no_read"
                    string="AI Read Forbidden"
                    domain="[('ai_no_read', '=', True)]"
                />
            </filter>
        </field>
    </record>
</odoo>
