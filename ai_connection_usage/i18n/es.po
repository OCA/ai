msgid ""
"The AI connection %(name)s reached its monthly spending cap (%(spend).2f of "
"%(cap).2f %(currency)s). Ask an administrator to raise it or wait for next "
"month."
msgstr ""
"La conexión de IA %(name)s llegó a su tope mensual de gasto (%(spend).2f de "
"%(cap).2f %(currency)s). Pedile a un administrador que lo suba o esperá al "
"mes que viene."

#. module: ai_connection_usage
#. odoo-python
#: code:addons/ai_connection_usage/models/ai_connection.py:0
msgid ""
"The company %(company)s reached its monthly AI spending cap (%(spend).2f of "
"%(cap).2f %(currency)s). Ask an administrator to raise it or wait for next "
"month."
msgstr ""
"La compañía %(company)s llegó a su tope mensual de gasto en IA (%(spend).2f "
"de %(cap).2f %(currency)s). Pedile a un administrador que lo suba o esperá "
"al mes que viene."

