<odoo>
    <record id="ai_connection_form_view" model="ir.ui.view">
        <field name="model">ai.connection</field>
        <field name="inherit_id" ref="ai_connection.ai_connection_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="before">
                <div class="oe_button_box" name="button_box" groups="base.group_system">
                    <button
                        name="action_view_usage"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-bar-chart"
                    >
                        <field name="usage_count" widget="statinfo" string="Calls" />
                    </button>
                </div>
            </xpath>
            <field name="kind" position="after">
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    options="{'no_create': True}"
                />
            </field>
            <notebook position="inside">
                <page string="Usage" name="usage_page" groups="base.group_system">
                    <group>
                        <group string="Prices">
                            <field name="usage_currency_id" />
                            <field name="usage_input_price" />
                            <field name="usage_output_price" />
                        </group>
                        <group string="Limits">
                            <field name="usage_month_cap" />
                            <field name="usage_month_spend" />
                            <field name="usage_store_content" />
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="ai_connection_list_view" model="ir.ui.view">
        <field name="model">ai.connection</field>
        <field name="inherit_id" ref="ai_connection.ai_connection_list_view" />
        <field name="arch" type="xml">
            <field name="kind" position="after">
                <field name="company_id" groups="base.group_multi_company" />
            </field>
        </field>
    </record>
</odoo>
